  "nodes": {
    "var_c741126f99e6": {
      "type": "variant",
      "label": "3 · Con tu especialista",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n:root{\n  --forest:#2B573C;\n  --sage:#4A7C59;\n  --mint:#F4FAF6;\n  --pale:#EBF5F0;\n  --gold:#D4AF37;\n  --ink:#183023;\n  --muted:#42634F;\n  --line:#CFE3D7;\n  --serif:'Playfair Display',Georgia,'Times New Roman',serif;\n  --sans:'Outfit',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n}\n\n*{box-sizing:border-box;}\nbody{\n  margin:0;\n  font-family:var(--sans);\n  font-size:16px;\n  line-height:1.55;\n  color:var(--ink);\n  background:#FFFFFF;\n  -webkit-font-smoothing:antialiased;\n}\nimg{display:block;max-width:100%;}\nh1,h2,h3,h4{margin:0;font-family:var(--serif);font-weight:600;letter-spacing:-0.01em;}\np{margin:0;}\ndl,dd{margin:0;}\na{color:inherit;text-decoration:none;}\nbutton{font-family:var(--sans);cursor:pointer;}\n.wrap{max-width:1240px;margin:0 auto;padding:0 48px;}\nsection{scroll-margin-top:96px;}\n\n/* ---------- NAVBAR ---------- */\n.nav{\n  position:fixed;top:0;left:0;right:0;z-index:120;\n  height:80px;background:rgba(255,255,255,.97);\n  border-bottom:1px solid var(--line);\n  backdrop-filter:blur(10px);\n}\n.nav-inner{\n  max-width:1240px;margin:0 auto;padding:0 48px;height:100%;\n  display:flex;align-items:center;justify-content:space-between;gap:32px;\n}\n.brand{display:flex;align-items:center;gap:12px;}\n.brand-tile{\n  width:42px;height:42px;border-radius:10px;background:#FFFFFF;\n  border:1px solid var(--line);display:flex;align-items:center;justify-content:center;\n}\n.brand-tile img{width:28px;height:28px;}\n.brand-name{font-family:var(--serif);font-size:19px;font-weight:600;color:var(--ink);line-height:1.15;}\n.brand-sub{display:block;font-family:var(--sans);font-size:10px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--sage);margin-top:2px;}\n.nav-links{display:flex;align-items:center;gap:32px;}\n.nav-links a{font-size:15px;color:var(--muted);transition:color .18s ease;}\n.nav-links a:hover{color:var(--forest);}\n.nav-actions{display:flex;align-items:center;gap:20px;}\n.nav-phone{font-size:14px;color:var(--muted);display:inline-flex;align-items:center;gap:7px;transition:color .18s ease;}\n.nav-phone:hover{color:var(--forest);}\n.nav-phone i{font-size:16px;color:var(--sage);}\n.btn{\n  border:none;border-radius:8px;font-size:14px;font-weight:600;\n  padding:12px 22px;display:inline-flex;align-items:center;gap:8px;\n  transition:background .18s ease,color .18s ease,border-color .18s ease;\n}\n.btn-sage{background:var(--sage);color:#FFFFFF;}\n.btn-sage:hover{background:var(--forest);}\n.btn-forest{background:var(--forest);color:#FFFFFF;padding:14px 24px;}\n.btn-forest:hover{background:#20432E;}\n\n/* ---------- HERO ---------- */\n.hero{\n  background:radial-gradient(1200px 520px at 78% -12%, #37684A 0%, rgba(55,104,74,0) 62%), var(--forest);\n  color:#FFFFFF;padding:136px 0 64px;\n}\n.hero-title{\n  font-size:52px;line-height:60px;font-weight:600;color:#FFFFFF;\n  max-width:780px;margin-bottom:44px;\n}\n.hero-lower{display:grid;grid-template-columns:660px 1fr;gap:56px;align-items:end;}\n.hero-photo{margin:0;width:660px;height:220px;border-radius:4px;overflow:hidden;background:#20432E;}\n.hero-photo img{width:100%;height:100%;object-fit:cover;}\n.hero-side{max-width:400px;padding-bottom:4px;}\n.hero-desc{font-size:16px;line-height:1.7;color:#DCEBE0;font-weight:300;}\n.hero-actions{display:flex;align-items:center;gap:24px;margin-top:26px;}\n.link-plain{\n  font-size:14px;font-weight:500;color:#EAF4EC;border-bottom:1px solid rgba(255,255,255,.35);\n  padding-bottom:2px;transition:border-color .18s ease,color .18s ease;\n}\n.link-plain:hover{color:#FFFFFF;border-color:var(--gold);}\n\n/* ---------- HEADINGS ---------- */\n.section-title{font-size:36px;line-height:1.15;color:var(--ink);}\n\n/* ---------- CATALOGUE ---------- */\n.services{background:var(--mint);padding:72px 0 80px;}\n.services-head{margin-bottom:20px;}\n.band{\n  display:grid;grid-template-columns:200px 1fr;gap:32px;align-items:start;\n  padding:32px 0;\n}\n.band + .band{border-top:1px solid var(--line);}\n.band-aside h3{font-size:21px;color:var(--forest);line-height:1.3;}\n.band-rule{display:block;width:28px;height:2px;background:var(--gold);margin:12px 0 0;}\n.band-photo{margin:18px 0 0;width:100%;height:112px;border-radius:8px;overflow:hidden;background:var(--pale);}\n.band-photo img{width:100%;height:100%;object-fit:cover;}\n.band-cards{display:grid;grid-template-columns:1fr;gap:20px;align-items:start;}\n.band-cards--pair{grid-template-columns:1fr 1fr;}\n.band-cards--pair .svc{grid-template-columns:1fr 146px;gap:20px;}\n\n.svc{\n  position:relative;background:#FFFFFF;border:1px solid var(--line);border-radius:12px;\n  padding:20px;display:grid;grid-template-columns:1fr 186px;gap:24px;\n  min-height:148px;align-content:center;\n  transition:background .18s ease,border-color .18s ease;\n  cursor:pointer;\n}\n.svc:hover{border-color:#A9CBB8;}\n.svc.is-selected{background:var(--pale);border-color:var(--sage);}\n.svc-head{display:flex;align-items:center;gap:10px;}\n.svc-name{font-size:21px;line-height:1.25;color:var(--ink);}\n.svc-mark{\n  width:20px;height:20px;border-radius:50%;background:var(--forest);color:#FFFFFF;\n  font-size:12px;display:none;align-items:center;justify-content:center;flex-shrink:0;\n}\n.svc.is-selected .svc-mark{display:inline-flex;}\n.svc-desc{font-size:13.5px;line-height:1.55;color:var(--muted);margin-top:8px;max-width:56ch;}\n.svc-desc--short{max-width:40ch;}\n.svc-right{display:flex;flex-direction:column;align-items:flex-end;gap:8px;text-align:right;}\n.svc-dur{font-size:15px;color:var(--muted);display:inline-flex;align-items:center;gap:6px;}\n.svc-dur span{font-size:13px;}\n.svc-price{font-size:19px;font-weight:600;color:var(--forest);}\n.btn-ghost{\n  background:transparent;border:1px solid var(--sage);color:var(--forest);\n  font-size:13.5px;font-weight:600;padding:9px 16px;border-radius:8px;margin-top:2px;\n  transition:background .18s ease,color .18s ease,border-color .18s ease;\n}\n.btn-ghost:hover{background:var(--forest);border-color:var(--forest);color:#FFFFFF;}\n\n/* ---------- BOOKING ---------- */\n.booking{background:#FFFFFF;padding:80px 0;}\n.book-head{margin-bottom:32px;}\n.book-grid{display:grid;grid-template-columns:360px 1fr;gap:48px;align-items:stretch;}\n.book-col{display:flex;flex-direction:column;min-width:0;}\n.field-label{\n  display:block;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;\n  color:var(--muted);margin-bottom:12px;\n}\n.pract-list{display:flex;flex-direction:column;gap:12px;}\n.pract-row{\n  display:flex;align-items:center;gap:14px;min-height:72px;padding:12px 16px;\n  background:#FFFFFF;border:1px solid var(--line);border-radius:12px;text-align:left;\n  transition:background .18s ease,border-color .18s ease;width:100%;\n}\n.pract-row:hover{border-color:var(--sage);}\n.pract-row.is-selected{background:var(--pale);border-color:var(--sage);}\n.pract-photo{width:44px;height:44px;border-radius:50%;object-fit:cover;flex:0 0 44px;border:1px solid var(--line);}\n.pract-text{flex:1;min-width:0;}\n.pract-name{display:block;font-size:15px;font-weight:600;color:var(--ink);}\n.pract-role{display:block;font-size:12.5px;color:var(--muted);margin-top:2px;}\n.radio{\n  width:18px;height:18px;border-radius:50%;border:1px solid #9DBFAB;flex-shrink:0;\n  display:flex;align-items:center;justify-content:center;color:transparent;font-size:11px;\n  transition:background .18s ease,border-color .18s ease,color .18s ease;\n}\n.pract-row.is-selected .radio{background:var(--forest);border-color:var(--forest);color:#FFFFFF;}\n\n/* service field */\n.svc-field{\n  display:flex;align-items:center;justify-content:space-between;gap:24px;\n  background:var(--mint);border:1px solid var(--line);border-radius:12px;padding:16px 20px;margin-bottom:28px;\n}\n.svc-field-main{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;}\n.svc-field-name{font-family:var(--serif);font-size:19px;font-weight:600;color:var(--ink);}\n.svc-field-meta{font-size:13.5px;color:var(--muted);}\n.link-quiet{font-size:13.5px;font-weight:600;color:var(--sage);white-space:nowrap;transition:color .18s ease;}\n.link-quiet:hover{color:var(--forest);}\n\n/* calendar */\n.cal{margin-bottom:28px;}\n.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}\n.cal-month{font-family:var(--serif);font-size:18px;color:var(--ink);}\n.cal-nav{display:flex;gap:8px;}\n.cal-btn{\n  width:34px;height:34px;border-radius:50%;background:#FFFFFF;border:1px solid var(--line);\n  color:var(--forest);display:flex;align-items:center;justify-content:center;font-size:16px;\n  transition:border-color .18s ease,background .18s ease;\n}\n.cal-btn:hover{border-color:var(--sage);background:var(--mint);}\n.dates{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;min-height:60px;}\n.date{\n  min-height:60px;padding:8px 4px;background:#FFFFFF;border:1px solid var(--line);border-radius:10px;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;\n  transition:background .18s ease,border-color .18s ease,color .18s ease;\n}\n.date-dow{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);}\n.date-num{font-size:17px;font-weight:600;color:var(--ink);line-height:1.2;}\n.date-note{font-size:9.5px;letter-spacing:.04em;color:#8AA89A;text-transform:uppercase;}\n.date:hover:not(.is-closed):not(.is-selected){border-color:var(--sage);}\n.date.is-selected{background:var(--forest);border-color:var(--forest);}\n.date.is-selected .date-dow{color:#CFE3D7;}\n.date.is-selected .date-num{color:#FFFFFF;}\n.date.is-closed{background:#FAFCFA;cursor:default;}\n.date.is-closed .date-dow,.date.is-closed .date-num{color:#9BB6A6;}\n\n/* slots */\n.slots-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px;}\n.slots{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:28px;}\n.slot{\n  height:44px;background:#FFFFFF;border:1px solid var(--line);border-radius:8px;\n  font-size:14px;font-weight:600;color:var(--ink);\n  transition:background .18s ease,border-color .18s ease,color .18s ease;\n}\n.slot:hover{border-color:var(--sage);background:var(--mint);}\n.slot.is-selected{background:var(--forest);border-color:var(--forest);color:#FFFFFF;}\n\n/* summary */\n.summary{\n  background:var(--pale);border-radius:12px;padding:24px;margin-top:24px;\n  display:flex;flex-direction:column;flex:1;\n}\n.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px 24px;}\n.summary-grid .row{display:flex;flex-direction:column;gap:2px;}\n.summary-grid .wide{grid-column:1 / -1;padding-bottom:14px;border-bottom:1px solid #D3E7DB;}\n.summary-grid dt{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;}\n.summary-grid dd{font-size:15px;font-weight:500;color:var(--ink);}\n.summary-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-top:auto;padding-top:20px;border-top:1px solid #D3E7DB;}\n.total{display:flex;align-items:baseline;gap:10px;}\n.total span{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);}\n.total strong{font-family:var(--serif);font-size:26px;font-weight:600;color:var(--forest);}\n.book-action{\n  margin-top:auto;padding-top:24px;border-top:1px solid var(--line);\n  display:flex;align-items:center;justify-content:flex-end;\n}\n\n/* ---------- TRUST ---------- */\n.trust{background:var(--pale);padding:26px 0;}\n.trust-grid{display:grid;grid-template-columns:repeat(3,1fr);}\n.trust-item{\n  display:flex;align-items:center;justify-content:center;gap:12px;\n  padding:8px 24px;color:var(--forest);\n}\n.trust-item + .trust-item{border-left:1px solid #D3E7DB;}\n.trust-item i{font-size:19px;color:var(--sage);}\n.trust-item span{font-size:15px;font-weight:500;color:var(--ink);}\n\n/* ---------- FOOTER ---------- */\n.foot{background:var(--mint);border-top:1px solid var(--line);padding:64px 0 0;}\n.foot-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:64px;padding-bottom:48px;}\n.foot-brand{font-family:var(--serif);font-size:26px;color:var(--ink);margin-bottom:24px;}\n.foot-cols{display:flex;gap:64px;}\n.foot-label{display:block;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;font-weight:600;}\n.foot-block p{font-size:15px;color:var(--ink);line-height:1.6;}\n.foot-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;}\n.foot-list li{display:flex;align-items:center;gap:10px;font-size:15px;}\n.foot-list i{font-size:17px;color:var(--sage);}\n.foot-list a{color:var(--ink);transition:color .18s ease;}\n.foot-list a:hover{color:var(--forest);text-decoration:underline;}\n.foot-bottom{\n  border-top:1px solid var(--gold);\n  display:flex;align-items:center;justify-content:space-between;gap:24px;\n  padding-top:20px;padding-bottom:24px;font-size:12.5px;color:var(--muted);\n}\n\n/* ---------- RESPONSIVE ---------- */\n@media (max-width:1180px){\n  .nav-links{gap:22px;}\n  .hero-lower{grid-template-columns:1fr 1fr;gap:40px;}\n  .hero-photo{width:100%;}\n}\n@media (max-width:1024px){\n  .wrap,.nav-inner{padding:0 32px;}\n  .hero{padding-top:120px;}\n  .hero-title{font-size:44px;line-height:52px;}\n  .hero-lower{grid-template-columns:1fr;gap:32px;align-items:start;}\n  .hero-photo{height:260px;}\n  .hero-side{max-width:640px;}\n  .nav-phone{display:none;}\n  .book-grid{grid-template-columns:1fr;gap:32px;}\n  .pract-list{display:grid;grid-template-columns:1fr 1fr;gap:12px;}\n  .band{grid-template-columns:160px 1fr;gap:24px;}\n  .band-cards--pair{grid-template-columns:1fr;}\n}\n@media (max-width:768px){\n  .wrap,.nav-inner{padding:0 20px;}\n  .nav{height:68px;}\n  .nav-links{display:none;}\n  .hero{padding:112px 0 48px;}\n  .hero-title{font-size:34px;line-height:40px;margin-bottom:28px;}\n  .hero-photo{height:200px;}\n  .section-title{font-size:28px;}\n  .services,.booking{padding:48px 0;}\n  .band{grid-template-columns:1fr;gap:16px;padding:24px 0;}\n  .band-photo{display:none;}\n  .band-aside{display:flex;align-items:baseline;gap:12px;}\n  .band-rule{margin:0;}\n  .svc{grid-template-columns:1fr;gap:16px;min-height:0;}\n  .svc-right{align-items:flex-start;text-align:left;flex-direction:row;flex-wrap:wrap;gap:14px;align-items:center;}\n  .pract-list{grid-template-columns:1fr;}\n  .dates{gap:6px;}\n  .date{min-height:52px;}\n  .slots{gap:8px;}\n  .summary-grid{grid-template-columns:1fr;}\n  .summary-foot{flex-direction:row;align-items:flex-end;gap:16px;}\n  .book-action{border-top:none;padding-top:10px;}\n  .book-action .btn{width:100%;justify-content:center;}\n  .trust-grid{grid-template-columns:1fr;gap:12px;}\n  .trust-item{justify-content:flex-start;}\n  .trust-item + .trust-item{border-left:none;}\n  .foot-grid{grid-template-columns:1fr;gap:36px;}\n  .foot-cols{flex-direction:column;gap:28px;}\n  .foot-bottom{flex-direction:column;align-items:flex-start;gap:6px;}\n}\n@media (max-width:420px){\n  .hero-title{font-size:30px;line-height:36px;}\n  .svc{padding:16px;}\n  .summary{padding:18px;}\n  .btn-sage{padding:10px 16px;}\n  .date-num{font-size:15px;}\n  .date-dow{font-size:10px;}\n}\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"fixed top navigation bar\">\n<div class=\"nav-inner\" data-kid=\"1-1\" data-name=\"navbar inner layout row\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo with salon name\" href=\"#top\">\n<span class=\"brand-tile\" data-kid=\"1-1-1-1\" data-name=\"brand logo image tile\"><img alt=\"Flor de loto de Salon Spa Aleida\" data-kid=\"1-1-1-1-1\" data-name=\"spa lotus logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/logo_zen_icon.svg\"/></span>\n<span data-kid=\"1-1-1-2\" data-name=\"brand text group\">\n<span class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"salon brand name\">Salon Spa Aleida</span>\n<span class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline subtitle\">Belleza &amp; Bienestar</span>\n</span>\n</a>\n<nav class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"primary navigation links\">\n<a data-kid=\"1-1-2-1\" data-name=\"navigation link to services section\" href=\"#servicios\">Servicios</a>\n<a data-kid=\"1-1-2-2\" data-name=\"navigation link to booking section\" href=\"#reservar\">Reservar</a>\n<a data-kid=\"1-1-2-3\" data-name=\"navigation link to contact/footer\" href=\"#contacto\">Contacto</a>\n</nav>\n<div class=\"nav-actions\" data-kid=\"1-1-3\" data-name=\"navbar right-side actions\">\n<a class=\"nav-phone\" data-kid=\"1-1-3-1\" data-name=\"phone number link with icon\" href=\"tel:+5114219876\"><i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"1-1-3-1-1\" data-name=\"phone icon\"></i>(01) 421-9876</a>\n<a class=\"btn btn-sage\" data-kid=\"1-1-3-2\" data-name=\"book appointment call-to-action button\" href=\"#reservar\">Reservar Cita</a>\n</div>\n</div>\n</header>\n<section class=\"hero\" data-kid=\"2\" data-name=\"hero section with green gradient background\" id=\"top\">\n<div class=\"wrap\" data-kid=\"2-1\" data-name=\"hero content container\">\n<h1 class=\"hero-title\" data-kid=\"2-1-1\" data-name=\"hero headline\">Renueva tu Belleza,<br data-kid=\"2-1-1-1\" data-name=\"line break between headline parts\"/>Equilibra tu Bienestar</h1>\n<div class=\"hero-lower\" data-kid=\"2-1-2\" data-name=\"hero lower row with photo and actions\">\n<figure class=\"hero-photo\" data-kid=\"2-1-2-1\" data-name=\"hero room photography figure\">\n<img alt=\"Sala de tratamientos con camilla, toallas blancas y luz cálida — fotografía de Marine Fougère en Pexels\" data-kid=\"2-1-2-1-1\" data-name=\"spa treatment room photograph\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35884502/pexels-photo-35884502.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200&amp;q=80\"/>\n</figure>\n<div class=\"hero-side\" data-kid=\"2-1-2-2\" data-name=\"hero side description and actions\">\n<p class=\"hero-desc\" data-kid=\"2-1-2-2-1\" data-name=\"hero description paragraph\">Rituales terapéuticos botánicos, tratamientos faciales antiedad y estilismo capilar personalizado, en un ambiente de calma, sofisticación y cuidado integral.</p>\n<div class=\"hero-actions\" data-kid=\"2-1-2-2-2\" data-name=\"hero call-to-action row\">\n<a class=\"btn btn-sage\" data-kid=\"2-1-2-2-2-1\" data-name=\"primary book appointment button\" href=\"#reservar\">Reservar Cita</a>\n<a class=\"link-plain\" data-kid=\"2-1-2-2-2-2\" data-name=\"view services link\" href=\"#servicios\">Ver servicios</a>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"services\" data-kid=\"3\" data-name=\"services catalogue section\" id=\"servicios\">\n<div class=\"wrap\" data-kid=\"3-1\" data-name=\"services section container\">\n<h2 class=\"section-title services-head\" data-kid=\"3-1-1\" data-name=\"services section heading\">Nuestros servicios</h2>\n<div class=\"band\" data-kid=\"3-1-2\" data-name=\"spa and wellness service band\">\n<div class=\"band-aside\" data-kid=\"3-1-2-1\" data-name=\"service category aside\">\n<h3 data-kid=\"3-1-2-1-1\" data-name=\"category headline: spa and wellness\">Spa &amp; Bienestar</h3>\n<span class=\"band-rule\" data-kid=\"3-1-2-1-2\" data-name=\"gold accent rule under headline\"></span>\n<figure class=\"band-photo\" data-kid=\"3-1-2-1-3\" data-name=\"category category photo figure\">\n<img alt=\"Cabina de tratamientos en penumbra con camilla, toallas dobladas y velas — fotografía de Marine Fougère en Pexels\" data-kid=\"3-1-2-1-3-1\" data-name=\"treatment cabin category photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35884499/pexels-photo-35884499.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=700&amp;q=80\"/>\n</figure>\n</div>\n<div class=\"band-cards\" data-kid=\"3-1-2-2\" data-name=\"service cards grid\">\n<article aria-pressed=\"true\" class=\"svc is-selected\" data-kid=\"3-1-2-2-1\" data-name=\"selected service card: relaxing massage\" data-service=\"masaje\" role=\"button\" tabindex=\"0\">\n<div data-kid=\"3-1-2-2-1-1\" data-name=\"service card detail column\">\n<div class=\"svc-head\" data-kid=\"3-1-2-2-1-1-1\" data-name=\"service card title row\">\n<h4 class=\"svc-name\" data-kid=\"3-1-2-2-1-1-1-1\" data-name=\"service card name: relaxing massage\">Masaje Relajante Aleida</h4>\n<span class=\"svc-mark\" data-kid=\"3-1-2-2-1-1-1-2\" data-name=\"selected checkmark indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"3-1-2-2-1-1-1-2-1\" data-name=\"checkmark icon\"></i></span>\n</div>\n<p class=\"svc-desc\" data-kid=\"3-1-2-2-1-1-2\" data-name=\"service description text\">Terapia antiestrés con aceites botánicos, aromaterapia personalizada y piedras calientes para disolver tensiones acumuladas.</p>\n</div>\n<div class=\"svc-right\" data-kid=\"3-1-2-2-1-2\" data-name=\"service card meta column\">\n<span class=\"svc-dur\" data-kid=\"3-1-2-2-1-2-1\" data-name=\"service duration with clock icon\"><i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"3-1-2-2-1-2-1-1\" data-name=\"clock icon\"></i><span data-kid=\"3-1-2-2-1-2-1-2\" data-name=\"duration value text\">90 min</span></span>\n<span class=\"svc-price\" data-kid=\"3-1-2-2-1-2-2\" data-name=\"service price value\">S/ 280.00</span>\n<button class=\"btn-ghost\" data-kid=\"3-1-2-2-1-2-3\" data-name=\"book appointment ghost button\" type=\"button\">Reservar Cita</button>\n</div>\n</article>\n</div>\n</div>\n<div class=\"band\" data-kid=\"3-1-3\" data-name=\"estética facial service band\">\n<div class=\"band-aside\" data-kid=\"3-1-3-1\" data-name=\"service category aside\">\n<h3 data-kid=\"3-1-3-1-1\" data-name=\"category headline: estética facial\">Estética Facial</h3>\n<span class=\"band-rule\" data-kid=\"3-1-3-1-2\" data-name=\"gold accent rule under headline\"></span>\n</div>\n<div class=\"band-cards\" data-kid=\"3-1-3-2\" data-name=\"service cards grid\">\n<article aria-pressed=\"false\" class=\"svc\" data-kid=\"3-1-3-2-1\" data-name=\"service card: rejuvenator golden facial\" data-service=\"facial\" role=\"button\" tabindex=\"0\">\n<div data-kid=\"3-1-3-2-1-1\" data-name=\"service card detail column\">\n<div class=\"svc-head\" data-kid=\"3-1-3-2-1-1-1\" data-name=\"service card title row\">\n<h4 class=\"svc-name\" data-kid=\"3-1-3-2-1-1-1-1\" data-name=\"service card name: golden facial\">Facial Rejuvenecedor con Oro</h4>\n<span class=\"svc-mark\" data-kid=\"3-1-3-2-1-1-1-2\" data-name=\"hidden checkmark indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"3-1-3-2-1-1-1-2-1\" data-name=\"checkmark icon\"></i></span>\n</div>\n<p class=\"svc-desc\" data-kid=\"3-1-3-2-1-1-2\" data-name=\"service description text\">Limpieza profunda e hidratación intensiva con micropartículas de oro coloidal y colágeno hidrolizado purificado.</p>\n</div>\n<div class=\"svc-right\" data-kid=\"3-1-3-2-1-2\" data-name=\"service card meta column\">\n<span class=\"svc-dur\" data-kid=\"3-1-3-2-1-2-1\" data-name=\"service duration with clock icon\"><i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"3-1-3-2-1-2-1-1\" data-name=\"clock icon\"></i><span data-kid=\"3-1-3-2-1-2-1-2\" data-name=\"duration value text\">75 min</span></span>\n<span class=\"svc-price\" data-kid=\"3-1-3-2-1-2-2\" data-name=\"service price value\">S/ 450.00</span>\n<button class=\"btn-ghost\" data-kid=\"3-1-3-2-1-2-3\" data-name=\"book appointment ghost button\" type=\"button\">Reservar Cita</button>\n</div>\n</article>\n</div>\n</div>\n<div class=\"band\" data-kid=\"3-1-4\" data-name=\"cuidado capilar service band\">\n<div class=\"band-aside\" data-kid=\"3-1-4-1\" data-name=\"service category aside\">\n<h3 data-kid=\"3-1-4-1-1\" data-name=\"category headline: hair care\">Cuidado Capilar</h3>\n<span class=\"band-rule\" data-kid=\"3-1-4-1-2\" data-name=\"gold accent rule under headline\"></span>\n<figure class=\"band-photo\" data-kid=\"3-1-4-1-3\" data-name=\"category photo figure\">\n<img alt=\"Toallas dobladas y productos de cuidado en el interior del spa — fotografía de Tima Miroshnichenko en Pexels\" data-kid=\"3-1-4-1-3-1\" data-name=\"hair care products photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6188050/pexels-photo-6188050.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=700&amp;q=80\"/>\n</figure>\n</div>\n<div class=\"band-cards band-cards--pair\" data-kid=\"3-1-4-2\" data-name=\"pair service cards grid\">\n<article aria-pressed=\"false\" class=\"svc\" data-kid=\"3-1-4-2-1\" data-name=\"service card: keratin treatment\" data-service=\"keratina\" role=\"button\" tabindex=\"0\">\n<div data-kid=\"3-1-4-2-1-1\" data-name=\"service card detail column\">\n<div class=\"svc-head\" data-kid=\"3-1-4-2-1-1-1\" data-name=\"service card title row\">\n<h4 class=\"svc-name\" data-kid=\"3-1-4-2-1-1-1-1\" data-name=\"service card name: keratin treatment\">Tratamiento Capilar Keratina</h4>\n<span class=\"svc-mark\" data-kid=\"3-1-4-2-1-1-1-2\" data-name=\"hidden checkmark indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"3-1-4-2-1-1-1-2-1\" data-name=\"checkmark icon\"></i></span>\n</div>\n<p class=\"svc-desc svc-desc--short\" data-kid=\"3-1-4-2-1-1-2\" data-name=\"service description text\">Nutrición intensiva con sellado térmico para eliminación total del frizz y brillo prolongado de calidad profesional.</p>\n</div>\n<div class=\"svc-right\" data-kid=\"3-1-4-2-1-2\" data-name=\"service card meta column\">\n<span class=\"svc-dur\" data-kid=\"3-1-4-2-1-2-1\" data-name=\"service duration with clock icon\"><i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"3-1-4-2-1-2-1-1\" data-name=\"clock icon\"></i><span data-kid=\"3-1-4-2-1-2-1-2\" data-name=\"duration value text\">120 min</span></span>\n<span class=\"svc-price\" data-kid=\"3-1-4-2-1-2-2\" data-name=\"service price value\">S/ 350.00</span>\n<button class=\"btn-ghost\" data-kid=\"3-1-4-2-1-2-3\" data-name=\"book appointment ghost button\" type=\"button\">Reservar Cita</button>\n</div>\n</article>\n<article aria-pressed=\"false\" class=\"svc\" data-kid=\"3-1-4-2-2\" data-name=\"service card: cut and styling\" data-service=\"corte\" role=\"button\" tabindex=\"0\">\n<div data-kid=\"3-1-4-2-2-1\" data-name=\"service card detail column\">\n<div class=\"svc-head\" data-kid=\"3-1-4-2-2-1-1\" data-name=\"service card title row\">\n<h4 class=\"svc-name\" data-kid=\"3-1-4-2-2-1-1-1\" data-name=\"service card name: cut and styling\">Corte y Peinado de Estilo</h4>\n<span class=\"svc-mark\" data-kid=\"3-1-4-2-2-1-1-2\" data-name=\"hidden checkmark indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"3-1-4-2-2-1-1-2-1\" data-name=\"checkmark icon\"></i></span>\n</div>\n<p class=\"svc-desc svc-desc--short\" data-kid=\"3-1-4-2-2-1-2\" data-name=\"service description text\">Asesoría de visagismo personalizada, lavado con shampoo dermocosmético, corte de autor y estilizado profesional.</p>\n</div>\n<div class=\"svc-right\" data-kid=\"3-1-4-2-2-2\" data-name=\"service card meta column\">\n<span class=\"svc-dur\" data-kid=\"3-1-4-2-2-2-1\" data-name=\"service duration with clock icon\"><i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"3-1-4-2-2-2-1-1\" data-name=\"clock icon\"></i><span data-kid=\"3-1-4-2-2-2-1-2\" data-name=\"duration value text\">45 min</span></span>\n<span class=\"svc-price\" data-kid=\"3-1-4-2-2-2-2\" data-name=\"service price value\">S/ 120.00</span>\n<button class=\"btn-ghost\" data-kid=\"3-1-4-2-2-2-3\" data-name=\"book appointment ghost button\" type=\"button\">Reservar Cita</button>\n</div>\n</article>\n</div>\n</div>\n<div class=\"band\" data-kid=\"3-1-5\" data-name=\"manicure and pedicure service band\">\n<div class=\"band-aside\" data-kid=\"3-1-5-1\" data-name=\"service category aside\">\n<h3 data-kid=\"3-1-5-1-1\" data-name=\"category headline: manicure and pedicure\">Manicura &amp; Pedicura</h3>\n<span class=\"band-rule\" data-kid=\"3-1-5-1-2\" data-name=\"gold accent rule under headline\"></span>\n</div>\n<div class=\"band-cards\" data-kid=\"3-1-5-2\" data-name=\"service cards grid\">\n<article aria-pressed=\"false\" class=\"svc\" data-kid=\"3-1-5-2-1\" data-name=\"service card: premium spa manicure\" data-service=\"manicura\" role=\"button\" tabindex=\"0\">\n<div data-kid=\"3-1-5-2-1-1\" data-name=\"service card detail column\">\n<div class=\"svc-head\" data-kid=\"3-1-5-2-1-1-1\" data-name=\"service card title row\">\n<h4 class=\"svc-name\" data-kid=\"3-1-5-2-1-1-1-1\" data-name=\"service card name: spa manicure\">Manicura Spa Premium</h4>\n<span class=\"svc-mark\" data-kid=\"3-1-5-2-1-1-1-2\" data-name=\"hidden checkmark indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"3-1-5-2-1-1-1-2-1\" data-name=\"checkmark icon\"></i></span>\n</div>\n<p class=\"svc-desc\" data-kid=\"3-1-5-2-1-1-2\" data-name=\"service description text\">Exfoliación con sales minerales marinas, hidratación profunda con parafina tibia y esmaltado de alta duración.</p>\n</div>\n<div class=\"svc-right\" data-kid=\"3-1-5-2-1-2\" data-name=\"service card meta column\">\n<span class=\"svc-dur\" data-kid=\"3-1-5-2-1-2-1\" data-name=\"service duration with clock icon\"><i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"3-1-5-2-1-2-1-1\" data-name=\"clock icon\"></i><span data-kid=\"3-1-5-2-1-2-1-2\" data-name=\"duration value text\">60 min</span></span>\n<span class=\"svc-price\" data-kid=\"3-1-5-2-1-2-2\" data-name=\"service price value\">S/ 150.00</span>\n<button class=\"btn-ghost\" data-kid=\"3-1-5-2-1-2-3\" data-name=\"book appointment ghost button\" type=\"button\">Reservar Cita</button>\n</div>\n</article>\n</div>\n</div>\n</div>\n</section>\n<section class=\"booking\" data-kid=\"4\" data-name=\"booking section\" id=\"reservar\">\n<div class=\"wrap\" data-kid=\"4-1\" data-name=\"booking section container\">\n<div class=\"book-head\" data-kid=\"4-1-1\" data-name=\"booking heading block\">\n<h2 class=\"section-title\" data-kid=\"4-1-1-1\" data-name=\"booking section heading\">Reserva tu cita</h2>\n</div>\n<div class=\"book-grid\" data-kid=\"4-1-2\" data-name=\"booking two-column grid\">\n<div class=\"book-col\" data-kid=\"4-1-2-1\" data-name=\"practitioner and summary column\">\n<span class=\"field-label\" data-kid=\"4-1-2-1-1\" data-name=\"practitioner field label\">Especialista</span>\n<div class=\"pract-list\" data-kid=\"4-1-2-1-2\" data-name=\"practitioner selection list\" id=\"practList\">\n<button aria-pressed=\"true\" class=\"pract-row is-selected\" data-kid=\"4-1-2-1-2-1\" data-name=\"selected practitioner row: Carmen Sánchez\" data-pract=\"Carmen Sánchez\" type=\"button\">\n<img alt=\"Carmen Sánchez — fotografía de xandro Vandewalle en Unsplash\" class=\"pract-photo\" data-kid=\"4-1-2-1-2-1-1\" data-name=\"practitioner avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1586165127014-f730957751f2?auto=format&amp;w=200&amp;h=200&amp;fit=crop&amp;q=80\"/>\n<span class=\"pract-text\" data-kid=\"4-1-2-1-2-1-2\" data-name=\"practitioner text group\">\n<span class=\"pract-name\" data-kid=\"4-1-2-1-2-1-2-1\" data-name=\"practitioner name\">Carmen Sánchez</span>\n<span class=\"pract-role\" data-dynamic=\"true\" data-kid=\"4-1-2-1-2-1-2-2\" data-name=\"practitioner role\" data-reason=\"false\">Cosmiatra &amp; Terapeuta Holística</span>\n</span>\n<span class=\"radio\" data-kid=\"4-1-2-1-2-1-3\" data-name=\"selected radio indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"4-1-2-1-2-1-3-1\" data-name=\"checkmark icon\"></i></span>\n</button>\n<button aria-pressed=\"false\" class=\"pract-row\" data-kid=\"4-1-2-1-2-2\" data-name=\"practitioner row: Luisa Paredes\" data-pract=\"Luisa Paredes\" type=\"button\">\n<img alt=\"Luisa Paredes — fotografía de Rendy Novantino en Unsplash\" class=\"pract-photo\" data-kid=\"4-1-2-1-2-2-1\" data-name=\"practitioner avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1620198361326-a319ba24ec94?auto=format&amp;w=200&amp;h=200&amp;fit=crop&amp;q=80\"/>\n<span class=\"pract-text\" data-kid=\"4-1-2-1-2-2-2\" data-name=\"practitioner text group\">\n<span class=\"pract-name\" data-kid=\"4-1-2-1-2-2-2-1\" data-name=\"practitioner name\">Luisa Paredes</span>\n<span class=\"pract-role\" data-dynamic=\"true\" data-kid=\"4-1-2-1-2-2-2-2\" data-name=\"practitioner role\" data-reason=\"false\">Estilista Capilar Senior</span>\n</span>\n<span class=\"radio\" data-kid=\"4-1-2-1-2-2-3\" data-name=\"empty radio indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"4-1-2-1-2-2-3-1\" data-name=\"checkmark icon\"></i></span>\n</button>\n<button aria-pressed=\"false\" class=\"pract-row\" data-kid=\"4-1-2-1-2-3\" data-name=\"practitioner row: Ana Vargas\" data-pract=\"Ana Vargas\" type=\"button\">\n<img alt=\"Ana Vargas — fotografía de Maria Isadora en Pexels\" class=\"pract-photo\" data-kid=\"4-1-2-1-2-3-1\" data-name=\"practitioner avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18090215/pexels-photo-18090215.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200&amp;h=200&amp;fit=crop&amp;q=80\"/>\n<span class=\"pract-text\" data-kid=\"4-1-2-1-2-3-2\" data-name=\"practitioner text group\">\n<span class=\"pract-name\" data-kid=\"4-1-2-1-2-3-2-1\" data-name=\"practitioner name\">Ana Vargas</span>\n<span class=\"pract-role\" data-dynamic=\"true\" data-kid=\"4-1-2-1-2-3-2-2\" data-name=\"practitioner role\" data-reason=\"false\">Especialista en Manicura &amp; Pedicura</span>\n</span>\n<span class=\"radio\" data-kid=\"4-1-2-1-2-3-3\" data-name=\"empty radio indicator\"><i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"4-1-2-1-2-3-3-1\" data-name=\"checkmark icon\"></i></span>\n</button>\n</div>\n<div class=\"summary\" data-kid=\"4-1-2-1-3\" data-name=\"booking summary surface\">\n<dl class=\"summary-grid\" data-kid=\"4-1-2-1-3-1\" data-name=\"summary detail grid\">\n<div class=\"row wide\" data-kid=\"4-1-2-1-3-1-1\" data-name=\"summary row: service\">\n<dt data-kid=\"4-1-2-1-3-1-1-1\" data-name=\"summary label: service\">Servicio</dt>\n<dd data-dynamic=\"true\" data-kid=\"4-1-2-1-3-1-1-2\" data-name=\"summary value: service name\" data-reason=\"text replaced with chosen service by script\" id=\"sService\">Masaje Relajante Aleida</dd>\n</div>\n<div class=\"row\" data-kid=\"4-1-2-1-3-1-2\" data-name=\"summary row: specialist\">\n<dt data-kid=\"4-1-2-1-3-1-2-1\" data-name=\"summary label: specialist\">Especialista</dt>\n<dd data-dynamic=\"true\" data-kid=\"4-1-2-1-3-1-2-2\" data-name=\"summary value: specialist name\" data-reason=\"text replaced from selected practitioner by script\" id=\"sPract\">Carmen Sánchez</dd>\n</div>\n<div class=\"row\" data-kid=\"4-1-2-1-3-1-3\" data-name=\"summary row: date\">\n<dt data-kid=\"4-1-2-1-3-1-3-1\" data-name=\"summary label: date\">Fecha</dt>\n<dd data-kid=\"4-1-2-1-3-1-3-2\" data-name=\"summary value: date\" id=\"sDate\">Mié 18 nov</dd>\n</div>\n<div class=\"row\" data-kid=\"4-1-2-1-3-1-4\" data-name=\"summary row: time\">\n<dt data-kid=\"4-1-2-1-3-1-4-1\" data-name=\"summary label: time\">Hora</dt>\n<dd data-kid=\"4-1-2-1-3-1-4-2\" data-name=\"summary value: time\" id=\"sTime\">09:00</dd>\n</div>\n<div class=\"row\" data-kid=\"4-1-2-1-3-1-5\" data-name=\"summary row: duration\">\n<dt data-kid=\"4-1-2-1-3-1-5-1\" data-name=\"summary label: duration\">Duración</dt>\n<dd data-dynamic=\"true\" data-kid=\"4-1-2-1-3-1-5-2\" data-name=\"summary value: duration\" data-reason=\"text replaced with chosen service duration by script\" id=\"sDur\">90 min</dd>\n</div>\n</dl>\n<div class=\"summary-foot\" data-kid=\"4-1-2-1-3-2\" data-name=\"summary footer with total\">\n<span class=\"total\" data-kid=\"4-1-2-1-3-2-1\" data-name=\"total price display\"><span data-kid=\"4-1-2-1-3-2-1-1\" data-name=\"total label\">Total</span><strong data-dynamic=\"true\" data-kid=\"4-1-2-1-3-2-1-2\" data-name=\"total amount value\" data-reason=\"text replaced with chosen service price by script\" id=\"sPrice\">S/ 280.00</strong></span>\n</div>\n</div>\n</div>\n<div class=\"book-col\" data-kid=\"4-1-2-2\" data-name=\"booking right column\">\n<div class=\"svc-field\" data-kid=\"4-1-2-2-1\" data-name=\"selected service summary field\">\n<div class=\"svc-field-main\" data-kid=\"4-1-2-2-1-1\" data-name=\"service name and meta row\">\n<span class=\"svc-field-name\" data-dynamic=\"true\" data-kid=\"4-1-2-2-1-1-1\" data-name=\"selected service name in booking\" data-reason=\"text replaced with chosen service name by summary render script\" id=\"fieldService\">Masaje Relajante Aleida</span>\n<span class=\"svc-field-meta\" data-dynamic=\"true\" data-kid=\"4-1-2-2-1-1-2\" data-name=\"service duration and price meta\" data-reason=\"text replaced with chosen service duration and price by script\" id=\"fieldServiceMeta\">90 min — S/ 280.00</span>\n</div>\n<a class=\"link-quiet\" data-kid=\"4-1-2-2-1-2\" data-name=\"change service link\" href=\"#servicios\">Cambiar</a>\n</div>\n<div class=\"cal\" data-kid=\"4-1-2-2-2\" data-name=\"date picking calendar\">\n<div class=\"cal-head\" data-kid=\"4-1-2-2-2-1\" data-name=\"calendar month header\">\n<span class=\"cal-month\" data-kid=\"4-1-2-2-2-1-1\" data-name=\"current month label\">Noviembre 2026</span>\n<div class=\"cal-nav\" data-kid=\"4-1-2-2-2-1-2\" data-name=\"month navigation arrow buttons\">\n<button aria-label=\"Semana anterior\" class=\"cal-btn\" data-kid=\"4-1-2-2-2-1-2-1\" data-name=\"previous month arrow button\" id=\"calPrev\" type=\"button\"><i aria-hidden=\"true\" class=\"ti ti-chevron-left\" data-kid=\"4-1-2-2-2-1-2-1-1\" data-name=\"chevron-left arrow icon\"></i></button>\n<button aria-label=\"Semana siguiente\" class=\"cal-btn\" data-kid=\"4-1-2-2-2-1-2-2\" data-name=\"next month arrow button\" id=\"calNext\" type=\"button\"><i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"4-1-2-2-2-1-2-2-1\" data-name=\"chevron-right arrow icon\"></i></button>\n</div>\n</div>\n<div class=\"dates\" data-dynamic=\"true\" data-kid=\"4-1-2-2-2-2\" data-name=\"date day grid container\" data-reason=\"child date buttons created/injected by the calendar render script\" id=\"dates\"></div>\n</div>\n<div class=\"slots-head\" data-kid=\"4-1-2-2-3\" data-name=\"time slot field header\">\n<span class=\"field-label\" data-kid=\"4-1-2-2-3-1\" data-name=\"time slot field label\">Horario</span>\n</div>\n<div class=\"slots\" data-kid=\"4-1-2-2-4\" data-name=\"time slot buttons grid\" id=\"slots\">\n<button aria-pressed=\"true\" class=\"slot is-selected\" data-kid=\"4-1-2-2-4-1\" data-name=\"selected time slot: 09:00\" data-time=\"09:00\" type=\"button\">09:00</button>\n<button aria-pressed=\"false\" class=\"slot\" data-kid=\"4-1-2-2-4-2\" data-name=\"time slot: 10:30\" data-time=\"10:30\" type=\"button\">10:30</button>\n<button aria-pressed=\"false\" class=\"slot\" data-kid=\"4-1-2-2-4-3\" data-name=\"time slot: 11:45\" data-time=\"11:45\" type=\"button\">11:45</button>\n<button aria-pressed=\"false\" class=\"slot\" data-kid=\"4-1-2-2-4-4\" data-name=\"time slot: 14:30\" data-time=\"14:30\" type=\"button\">14:30</button>\n<button aria-pressed=\"false\" class=\"slot\" data-kid=\"4-1-2-2-4-5\" data-name=\"time slot: 16:30\" data-time=\"16:30\" type=\"button\">16:30</button>\n<button aria-pressed=\"false\" class=\"slot\" data-kid=\"4-1-2-2-4-6\" data-name=\"time slot: 18:00\" data-time=\"18:00\" type=\"button\">18:00</button>\n</div>\n<div class=\"book-action\" data-kid=\"4-1-2-2-5\" data-name=\"continue booking action row\">\n<button class=\"btn btn-forest\" data-kid=\"4-1-2-2-5-1\" data-name=\"continue reservation primary button\" type=\"button\">Continuar reserva</button>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"trust\" data-kid=\"5\" data-name=\"trust strip section\">\n<div class=\"wrap trust-grid\" data-kid=\"5-1\" data-name=\"trust items row\">\n<div class=\"trust-item\" data-kid=\"5-1-1\" data-name=\"trust item: medical biosecurity\"><i aria-hidden=\"true\" class=\"ti ti-shield-check\" data-kid=\"5-1-1-1\" data-name=\"shield with check icon\"></i><span data-kid=\"5-1-1-2\" data-name=\"trust item label\">Bioseguridad médica</span></div>\n<div class=\"trust-item\" data-kid=\"5-1-2\" data-name=\"trust item: private cabins\"><i aria-hidden=\"true\" class=\"ti ti-door\" data-kid=\"5-1-2-1\" data-name=\"door icon\"></i><span data-kid=\"5-1-2-2\" data-name=\"trust item label\">Cabinas privadas</span></div>\n<div class=\"trust-item\" data-kid=\"5-1-3\" data-name=\"trust item: certified therapists\"><i aria-hidden=\"true\" class=\"ti ti-certificate\" data-kid=\"5-1-3-1\" data-name=\"certificate icon\"></i><span data-kid=\"5-1-3-2\" data-name=\"trust item label\">Terapeutas certificadas</span></div>\n</div>\n</section>\n<footer class=\"foot\" data-kid=\"6\" data-name=\"site footer\" id=\"contacto\">\n<div class=\"wrap foot-grid\" data-kid=\"6-1\" data-name=\"footer main grid\">\n<div data-kid=\"6-1-1\" data-name=\"footer brand and info column\">\n<h2 class=\"foot-brand\" data-kid=\"6-1-1-1\" data-name=\"footer brand name\">Salon Spa Aleida</h2>\n<div class=\"foot-cols\" data-kid=\"6-1-1-2\" data-name=\"footer info columns\">\n<div class=\"foot-block\" data-kid=\"6-1-1-2-1\" data-name=\"opening hours block\">\n<span class=\"foot-label\" data-kid=\"6-1-1-2-1-1\" data-name=\"footer label: opening hours\">Horarios</span>\n<p data-kid=\"6-1-1-2-1-2\" data-name=\"hours value text\">Lunes a Sábado<br data-kid=\"6-1-1-2-1-2-1\" data-name=\"line break in hours\"/>09:00 – 20:00</p>\n</div>\n<div class=\"foot-block\" data-kid=\"6-1-1-2-2\" data-name=\"location address block\">\n<span class=\"foot-label\" data-kid=\"6-1-1-2-2-1\" data-name=\"footer label: address\">Dirección</span>\n<p data-kid=\"6-1-1-2-2-2\" data-name=\"address value text\">Av. Conquistadores 450<br data-kid=\"6-1-1-2-2-2-1\" data-name=\"line break in address\"/>Lima — Perú</p>\n</div>\n</div>\n</div>\n<div data-kid=\"6-1-2\" data-name=\"footer contact column\">\n<span class=\"foot-label\" data-kid=\"6-1-2-1\" data-name=\"footer label: contact\">Contacto</span>\n<ul class=\"foot-list\" data-kid=\"6-1-2-2\" data-name=\"contact info list\">\n<li data-kid=\"6-1-2-2-1\" data-name=\"phone contact list row\"><i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"6-1-2-2-1-1\" data-name=\"phone icon\"></i><a data-kid=\"6-1-2-2-1-2\" data-name=\"phone number link\" href=\"tel:+5114219876\">(01) 421-9876</a></li>\n<li data-kid=\"6-1-2-2-2\" data-name=\"whatsapp contact list row\"><i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp\" data-kid=\"6-1-2-2-2-1\" data-name=\"whatsapp icon\"></i><a data-kid=\"6-1-2-2-2-2\" data-name=\"whatsapp number link\" href=\"https://wa.me/51987654321\">987 654 321</a></li>\n<li data-kid=\"6-1-2-2-3\" data-name=\"email contact list row\"><i aria-hidden=\"true\" class=\"ti ti-mail\" data-kid=\"6-1-2-2-3-1\" data-name=\"email icon\"></i><a data-kid=\"6-1-2-2-3-2\" data-name=\"email address link\" href=\"mailto:contacto@salonspaaleida.com\">contacto@salonspaaleida.com</a></li>\n</ul>\n</div>\n</div>\n<div class=\"wrap foot-bottom\" data-kid=\"6-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"6-2-1\" data-name=\"footer copyright notice\">© 2026 Salon Spa Aleida S.A.C. Todos los derechos reservados.</span>\n<span data-kid=\"6-2-2\" data-name=\"footer registration number\">RUC 20608192831</span>\n</div>\n</footer>\n<script>\n(function(){\n  var services = {\n    masaje:   {name:'Masaje Relajante Aleida',     dur:'90 min',  price:'S/ 280.00'},\n    facial:   {name:'Facial Rejuvenecedor con Oro', dur:'75 min',  price:'S/ 450.00'},\n    keratina: {name:'Tratamiento Capilar Keratina', dur:'120 min', price:'S/ 350.00'},\n    corte:    {name:'Corte y Peinado de Estilo',    dur:'45 min',  price:'S/ 120.00'},\n    manicura: {name:'Manicura Spa Premium',         dur:'60 min',  price:'S/ 150.00'}\n  };\n\n  var weeks = [\n    [{dow:'Lun',n:16},{dow:'Mar',n:17},{dow:'Mié',n:18},{dow:'Jue',n:19},{dow:'Vie',n:20},{dow:'Sáb',n:21},{dow:'Dom',n:22,closed:true}],\n    [{dow:'Lun',n:23},{dow:'Mar',n:24},{dow:'Mié',n:25},{dow:'Jue',n:26},{dow:'Vie',n:27},{dow:'Sáb',n:28},{dow:'Dom',n:29,closed:true}]\n  ];\n\n  var state = {service:'masaje', pract:'Carmen Sánchez', time:'09:00', week:0};\n  var selDate = {dow:'Mié', n:18};\n\n  function $(id){ return document.getElementById(id); }\n\n  function renderSummary(){\n    var s = services[state.service];\n    $('fieldService').textContent = s.name;\n    $('fieldServiceMeta').textContent = s.dur + ' — ' + s.price;\n    $('sService').textContent = s.name;\n    $('sPract').textContent = state.pract;\n    $('sDate').textContent = selDate.dow + ' ' + selDate.n + ' nov';\n    $('sTime').textContent = state.time;\n    $('sDur').textContent = s.dur;\n    $('sPrice').textContent = s.price;\n  }\n\n  function renderDates(){\n    var host = $('dates');\n    host.innerHTML = '';\n    weeks[state.week].forEach(function(day){\n      var b = document.createElement('button');\n      b.type = 'button';\n      var selected = !day.closed && selDate.n === day.n;\n      b.className = 'date' + (day.closed ? ' is-closed' : '') + (selected ? ' is-selected' : '');\n      b.innerHTML = '<span class=\"date-dow\">' + day.dow + '</span>' +\n                    '<span class=\"date-num\">' + (day.closed ? '—' : day.n) + '</span>' +\n                    (day.closed ? '<span class=\"date-note\">Cerrado</span>' : '');\n      if(day.closed){\n        b.disabled = true;\n      } else {\n        b.addEventListener('click', function(){\n          selDate = {dow: day.dow, n: day.n};\n          renderDates();\n          renderSummary();\n        });\n      }\n      host.appendChild(b);\n    });\n  }\n\n  Array.prototype.forEach.call(document.querySelectorAll('.pract-row'), function(row){\n    row.addEventListener('click', function(){\n      Array.prototype.forEach.call(document.querySelectorAll('.pract-row'), function(r){\n        r.classList.remove('is-selected');\n        r.setAttribute('aria-pressed','false');\n      });\n      row.classList.add('is-selected');\n      row.setAttribute('aria-pressed','true');\n      state.pract = row.getAttribute('data-pract');\n      renderSummary();\n    });\n  });\n\n  Array.prototype.forEach.call(document.querySelectorAll('.slot'), function(slot){\n    slot.addEventListener('click', function(){\n      Array.prototype.forEach.call(document.querySelectorAll('.slot'), function(s){\n        s.classList.remove('is-selected');\n        s.setAttribute('aria-pressed','false');\n      });\n      slot.classList.add('is-selected');\n      slot.setAttribute('aria-pressed','true');\n      state.time = slot.getAttribute('data-time');\n      renderSummary();\n    });\n  });\n\n  Array.prototype.forEach.call(document.querySelectorAll('.svc'), function(card){\n    function choose(){\n      state.service = card.getAttribute('data-service');\n      Array.prototype.forEach.call(document.querySelectorAll('.svc'), function(c){\n        var on = c === card;\n        if(on){ c.classList.add('is-selected'); } else { c.classList.remove('is-selected'); }\n        c.setAttribute('aria-pressed', on ? 'true' : 'false');\n      });\n      renderSummary();\n      var target = document.getElementById('reservar');\n      if(target && target.scrollIntoView){ target.scrollIntoView({behavior:'smooth', block:'start'}); }\n    }\n    card.addEventListener('click', choose);\n    card.addEventListener('keydown', function(e){\n      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); choose(); }\n    });\n  });\n\n  $('calPrev').addEventListener('click', function(){\n    state.week = state.week === 0 ? weeks.length - 1 : state.week - 1;\n    renderDates();\n  });\n  $('calNext').addEventListener('click', function(){\n    state.week = state.week === weeks.length - 1 ? 0 : state.week + 1;\n    renderDates();\n  });\n\n  renderDates();\n  renderSummary();\n})();\n</script>",
