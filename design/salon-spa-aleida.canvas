=\"true\" data-kid=\"1-4-5-2-3-2\" data-name=\"summary date value\" data-reason=\"text rewritten by script when date selection changes\" id=\"sDate\">Mié 18 de noviembre</dd></div>\n<div class=\"row\" data-kid=\"1-4-5-2-4\" data-name=\"summary time row\"><dt data-kid=\"1-4-5-2-4-1\" data-name=\"summary time label\">Horario</dt><dd data-dynamic=\"true\" data-kid=\"1-4-5-2-4-2\" data-name=\"summary time value\" data-reason=\"text rewritten by script when time slot selection changes\" id=\"sTime\">11:45</dd></div>\n<div class=\"row\" data-kid=\"1-4-5-2-5\" data-name=\"summary duration row\"><dt data-kid=\"1-4-5-2-5-1\" data-name=\"summary duration label\">Duración</dt><dd data-dynamic=\"true\" data-kid=\"1-4-5-2-5-2\" data-name=\"summary duration value\" data-reason=\"text rewritten by script when service selection changes\" id=\"sDur\">90 min</dd></div>\n<div class=\"row total\" data-kid=\"1-4-5-2-6\" data-name=\"summary total row\"><dt data-kid=\"1-4-5-2-6-1\" data-name=\"summary total label\">Total</dt><dd data-dynamic=\"true\" data-kid=\"1-4-5-2-6-2\" data-name=\"summary total price value\" data-reason=\"text rewritten by script when service selection changes\" id=\"sTotal\">S/ 280.00</dd></div>\n</dl>\n<button class=\"btn btn-confirm\" data-kid=\"1-4-5-3\" data-name=\"confirm booking button\" type=\"button\">Continuar reserva</button>\n</div>\n</section>\n<aside class=\"trust\" data-kid=\"1-5\" data-name=\"trust and footer container\">\n<ul data-kid=\"1-5-1\" data-name=\"trust badges list\">\n<li data-kid=\"1-5-1-1\" data-name=\"trust item: medical biosecurity\"><i aria-hidden=\"true\" class=\"ti ti-shield-check\" data-kid=\"1-5-1-1-1\" data-name=\"shield check icon\"></i>Bioseguridad médica</li>\n<li data-kid=\"1-5-1-2\" data-name=\"trust item: private cabins\"><i aria-hidden=\"true\" class=\"ti ti-door\" data-kid=\"1-5-1-2-1\" data-name=\"door icon\"></i>Cabinas privadas</li>\n<li data-kid=\"1-5-1-3\" data-name=\"trust item: certified therapists\"><i aria-hidden=\"true\" class=\"ti ti-certificate\" data-kid=\"1-5-1-3-1\" data-name=\"certificate icon\"></i>Terapeutas certificadas</li>\n</ul>\n<footer class=\"footer\" data-kid=\"1-5-2\" data-name=\"page footer\">\n<p class=\"fname\" data-kid=\"1-5-2-1\" data-name=\"footer brand name\">Salon Spa Aleida</p>\n<div class=\"fblock\" data-kid=\"1-5-2-2\" data-name=\"footer opening hours block\">\n<p class=\"fl\" data-kid=\"1-5-2-2-1\" data-name=\"footer opening hours label\">Horarios</p>\n<p data-kid=\"1-5-2-2-2\" data-name=\"footer opening hours text\">Lunes a Sábado, 09:00 – 20:00<br data-kid=\"1-5-2-2-2-1\" data-name=\"line break\"/>Domingo, cerrado</p>\n</div>\n<div class=\"fblock\" data-kid=\"1-5-2-3\" data-name=\"footer address block\">\n<p class=\"fl\" data-kid=\"1-5-2-3-1\" data-name=\"footer address label\">Dirección</p>\n<p data-kid=\"1-5-2-3-2\" data-name=\"footer address text\">Av. Conquistadores 450<br data-kid=\"1-5-2-3-2-1\" data-name=\"line break\"/>Lima — Perú</p>\n</div>\n<div class=\"fblock\" data-kid=\"1-5-2-4\" data-name=\"footer contact block\">\n<span class=\"fl\" data-kid=\"1-5-2-4-1\" data-name=\"footer contact label\">Contacto</span>\n<a class=\"flink\" data-kid=\"1-5-2-4-2\" data-name=\"footer phone contact link\" href=\"tel:+5114219876\"><i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"1-5-2-4-2-1\" data-name=\"phone icon\"></i>(01) 421-9876</a>\n<a class=\"flink\" data-kid=\"1-5-2-4-3\" data-name=\"footer whatsapp contact link\" href=\"https://wa.me/51987654321\"><i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp\" data-kid=\"1-5-2-4-3-1\" data-name=\"whatsapp brand icon\"></i>987 654 321</a>\n<a class=\"flink\" data-kid=\"1-5-2-4-4\" data-name=\"footer email contact link\" href=\"mailto:contacto@salonspaaleida.com\"><i aria-hidden=\"true\" class=\"ti ti-mail\" data-kid=\"1-5-2-4-4-1\" data-name=\"email icon\"></i>contacto@salonspaaleida.com</a>\n</div>\n<div class=\"fbottom\" data-kid=\"1-5-2-5\" data-name=\"footer legal bottom bar\">\n<span data-kid=\"1-5-2-5-1\" data-name=\"company legal name text\">Salon Spa Aleida S.A.C.</span>\n<span data-kid=\"1-5-2-5-2\" data-name=\"tax registration number text\">RUC 20608192831</span>\n</div>\n</footer>\n</aside></div>\n<script>\n(function () {\n  var state = { service: 'Masaje Relajante Aleida', dur: '90 min', price: 'S/ 280.00', sp: 'Carmen Sánchez', date: 'Mié 18 de noviembre', time: '11:45' };\n  var $ = function (s) { return document.querySelector(s); };\n\n  function render() {\n    $('#sService').textContent = state.service;\n    $('#sSp').textContent = state.sp;\n    $('#sDate').textContent = state.date;\n    $('#sTime').textContent = state.time;\n    $('#sDur').textContent = state.dur;\n    $('#sTotal').textContent = state.price;\n    $('#slotDate').textContent = state.date;\n  }\n\n  Array.prototype.forEach.call(document.querySelectorAll('.svc'), function (card) {\n    card.addEventListener('click', function (e) {\n      if (e.target.closest('.btn-outline')) { e.preventDefault(); }\n      Array.prototype.forEach.call(document.querySelectorAll('.svc'), function (c) { c.classList.remove('is-sel'); });\n      card.classList.add('is-sel');\n      state.service = card.dataset.service;\n      state.dur = card.dataset.dur;\n      state.price = card.dataset.price;\n      render();\n    });\n  });\n\n  Array.prototype.forEach.call(document.querySelectorAll('.sp'), function (row) {\n    row.addEventListener('click', function () {\n      Array.prototype.forEach.call(document.querySelectorAll('.sp'), function (r) { r.classList.remove('is-sel'); });\n      row.classList.add('is-sel');\n      state.sp = row.dataset.sp;\n      render();\n    });\n  });\n\n  Array.prototype.forEach.call(document.querySelectorAll('.day[data-date]'), function (day) {\n    day.addEventListener('click', function () {\n      Array.prototype.forEach.call(document.querySelectorAll('.day[data-date]'), function (d) { d.classList.remove('is-sel'); });\n      day.classList.add('is-sel');\n      state.date = day.dataset.date;\n      render();\n    });\n  });\n\n  Array.prototype.forEach.call(document.querySelectorAll('.slot[data-time]'), function (slot) {\n    slot.addEventListener('click', function () {\n      Array.prototype.forEach.call(document.querySelectorAll('.slot'), function (s) { s.classList.remove('is-sel'); });\n      slot.classList.add('is-sel');\n      state.time = slot.dataset.time;\n      render();\n    });\n  });\n\n  render();\n})();\n</script>\n",
