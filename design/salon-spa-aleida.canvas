        "h": 0
      },
      "html": "<style>\n@import url(\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n\n:root{\n  --forest:#2B573C;\n  --forest-deep:#234733;\n  --sage:#4A7C59;\n  --mint:#F4FAF6;\n  --white:#FFFFFF;\n  --pale:#EBF5F0;\n  --gold:#D4AF37;\n  --ink:#183023;\n  --muted:#42634F;\n  --soft:#6E8F7C;\n  --border:#CFE3D7;\n  --border-soft:#E4F1E9;\n  --serif:'Playfair Display', Georgia, serif;\n  --sans:'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n}\n*,*::before,*::after{box-sizing:border-box}\nbody{margin:0;background:var(--mint);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}\nh1,h2,h3{margin:0;font-family:var(--serif);font-weight:600;letter-spacing:-0.01em;color:var(--ink)}\np{margin:0}\na{text-decoration:none;color:inherit}\nbutton{font-family:inherit}\nimg{display:block}\n.wrap{max-width:1336px;margin:0 auto;padding:0 48px}\n\n.btn{\n  display:inline-flex;align-items:center;justify-content:center;gap:8px;\n  min-height:44px;padding:0 26px;border-radius:6px;border:1px solid transparent;\n  font-family:var(--sans);font-size:15px;font-weight:500;letter-spacing:.01em;\n  cursor:pointer;transition:background-color .18s ease,color .18s ease,border-color .18s ease;\n}\n.btn-sage{background:var(--forest);color:#fff}\n.btn-sage:hover{background:var(--forest-deep)}\n\n/* ================= NAVBAR ================= */\n.nav{position:sticky;top:0;z-index:60;background:var(--white);border-bottom:1px solid var(--border-soft)}\n.nav-inner{max-width:1336px;margin:0 auto;padding:0 48px;height:80px;display:flex;align-items:center;justify-content:space-between;gap:32px}\n.brand{display:flex;align-items:center;gap:12px}\n.brand-mark{width:38px;height:38px;border-radius:8px;background:var(--pale);display:flex;align-items:center;justify-content:center;flex-shrink:0}\n.brand-mark img{width:28px;height:28px}\n.brand-name{display:block;font-family:var(--serif);font-size:19px;font-weight:600;color:var(--ink);line-height:1.2}\n.brand-sub{display:block;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--sage);font-weight:500;margin-top:3px}\n.nav-links{display:flex;align-items:center;gap:34px}\n.nav-links a{font-size:15px;font-weight:500;color:var(--muted);padding:6px 0;border-bottom:1px solid transparent;transition:color .18s ease,border-color .18s ease}\n.nav-links a:hover{color:var(--forest);border-bottom-color:var(--gold)}\n\n/* ================= HERO ================= */\n.hero{background:linear-gradient(158deg,#2B573C 0%,#27503A 54%,#234733 100%);color:#fff;overflow:hidden}\n.hero-inner{max-width:1336px;margin:0 auto;padding:40px 48px 52px}\n.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,760px);column-gap:40px;row-gap:36px}\n.hero-photo{grid-column:2;margin:0;height:250px;overflow:hidden;border-radius:2px}\n.hero-photo img{width:100%;height:100%;object-fit:cover}\n.hero-text{grid-column:1 / -1;max-width:780px}\n.hero h1{font-size:54px;line-height:62px;font-weight:600;color:#fff;letter-spacing:-0.015em}\n.hero-lead{margin-top:18px;max-width:546px;font-size:17px;line-height:1.75;font-weight:300;color:#DCEDE2}\n.hero-cta{margin-top:26px}\n.hero .btn-sage{background:var(--sage)}\n.hero .btn-sage:hover{background:#3E6B4C}\n\n/* ================= CATALOGUE ================= */\n.catalogue{background:var(--mint);padding:80px 0 88px}\n.catalogue-head{margin-bottom:34px}\n.catalogue h2{font-size:40px;line-height:1.2}\n.catalogue-grid{display:grid;grid-template-columns:300px minmax(0,1fr);gap:40px;align-items:start}\n.atmosphere{display:flex;flex-direction:column;gap:20px}\n.atmosphere figure{margin:0;overflow:hidden;border-radius:2px}\n.atmosphere img{width:100%;object-fit:cover}\n.atmosphere .a-tall img{height:392px}\n.atmosphere .a-wide img{height:208px}\n\n.menu{display:flex;flex-direction:column;gap:8px}\n.treat{\n  display:grid;grid-template-columns:22px minmax(0,1fr) 92px 116px 148px;\n  align-items:center;gap:20px;padding:18px 22px;text-align:left;width:100%;\n  background:var(--white);border:1px solid var(--border-soft);border-radius:3px;\n  cursor:pointer;transition:background-color .18s ease,border-color .18s ease;\n}\n.treat:hover{border-color:var(--border)}\n.treat:focus-visible{outline:2px solid var(--sage);outline-offset:2px}\n.treat.is-selected{background:var(--pale);border-color:var(--sage)}\n.treat-check{width:20px;height:20px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;transition:background-color .18s ease,border-color .18s ease,color .18s ease}\n.treat-check i{font-size:12px;line-height:1;color:transparent;transition:color .18s ease}\n.treat.is-selected .treat-check{background:var(--sage);border-color:var(--sage)}\n.treat.is-selected .treat-check i{color:#fff}\n.treat-main{min-width:0}\n.treat h3{font-size:19px;line-height:1.3;font-weight:600}\n.treat-desc{margin-top:5px;min-height:63px;font-size:14px;line-height:1.5;color:var(--muted)}\n.treat-dur{display:flex;align-items:center;justify-content:flex-end;gap:6px;font-size:14px;font-weight:500;color:var(--muted);white-space:nowrap}\n.treat-dur i{font-size:16px;color:var(--soft)}\n.treat-price{font-family:var(--serif);font-size:19px;font-weight:600;text-align:right;white-space:nowrap}\n.treat-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 14px;border:1px solid var(--sage);border-radius:6px;background:#fff;color:var(--forest);font-size:14px;font-weight:500;white-space:nowrap;transition:background-color .18s ease,color .18s ease}\n.treat:hover .treat-btn{background:var(--forest);color:#fff}\n\n/* ================= BOOKING ================= */\n.booking{background:var(--white);border-top:1px solid var(--border-soft);padding:80px 0 88px}\n.booking h2{font-size:36px;line-height:1.2}\n.gold-rule{width:64px;height:1px;background:var(--gold);opacity:.85;margin:18px 0 40px}\n.booking-grid{display:grid;grid-template-columns:minmax(0,1fr) 336px;gap:48px;align-items:start}\n.field{margin-bottom:28px}\n.field:last-child{margin-bottom:0}\n.field-label{display:block;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--soft);margin-bottom:10px}\n.field-row{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:10px}\n.field-row .field-label{margin-bottom:0}\n.month{font-size:13px;font-weight:500;color:var(--muted)}\n\n.select-wrap{position:relative}\n.select-wrap select{\n  width:100%;height:56px;padding:0 46px 0 18px;background:#F9FDFA;border:1px solid var(--border);\n  border-radius:3px;font-family:var(--sans);font-size:16px;font-weight:500;color:var(--ink);\n  appearance:none;-webkit-appearance:none;cursor:pointer;transition:border-color .18s ease,background-color .18s ease;\n}\n.select-wrap select:hover{background:#F4FBF7}\n.select-wrap select:focus{outline:none;border-color:var(--sage);box-shadow:0 0 0 3px rgba(74,124,89,.14)}\n.select-wrap i{position:absolute;right:16px;top:50%;transform:translateY(-50%);font-size:18px;color:var(--sage);pointer-events:none}\n\n.specialist-list{border:1px solid var(--border);border-radius:3px;overflow:hidden;background:#fff}\n.specialist{display:flex;align-items:center;gap:14px;width:100%;padding:13px 16px;background:transparent;border:0;border-bottom:1px solid var(--border-soft);cursor:pointer;text-align:left;transition:background-color .18s ease}\n.specialist:last-child{border-bottom:0}\n.specialist:hover{background:#F7FCF9}\n.specialist.is-selected{background:var(--pale)}\n.specialist img{width:44px;height:44px;border-radius:50%;object-fit:cover;flex-shrink:0}\n.sp-text{flex:1;min-width:0}\n.sp-name{display:block;font-size:15px;font-weight:600;color:var(--ink);line-height:1.35}\n.sp-role{display:block;font-size:13px;color:var(--muted);line-height:1.4}\n.radio{width:18px;height:18px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:border-color .18s ease}\n.radio::after{content:\"\";width:8px;height:8px;border-radius:50%;background:transparent;transition:background-color .18s ease}\n.specialist.is-selected .radio{border-color:var(--sage)}\n.specialist.is-selected .radio::after{background:var(--sage)}\n\n.dates{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}\n.date{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;height:64px;padding:0;background:#fff;border:1px solid var(--border-soft);border-radius:3px;cursor:pointer;color:var(--ink);transition:background-color .18s ease,border-color .18s ease,color .18s ease}\n.date:hover{border-color:var(--sage)}\n.date-dow{font-size:10px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;color:var(--soft)}\n.date-num{font-family:var(--serif);font-size:18px;font-weight:600;line-height:1.1}\n.date-note{font-size:9px;line-height:1.2;color:#9BB3A5}\n.date.is-selected{background:var(--forest);border-color:var(--forest);color:#fff}\n.date.is-selected .date-dow{color:#C6DECD}\n.date.is-closed{background:#F7FBF8;cursor:not-allowed;color:#9FB6A8}\n.date.is-closed .date-num{color:#9FB6A8}\n.date.is-closed:hover{border-color:var(--border-soft)}\n\n.times{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\n.time{height:44px;border:1px solid var(--border);border-radius:3px;background:#fff;font-size:15px;font-weight:500;color:var(--ink);cursor:pointer;transition:background-color .18s ease,border-color .18s ease,color .18s ease}\n.time:hover{border-color:var(--sage);background:#F7FCF9}\n.time.is-selected{background:var(--sage);border-color:var(--sage);color:#fff}\n.time:disabled{background:#F5FAF7;border-color:var(--border-soft);color:#A9BFB2;cursor:not-allowed}\n.time:disabled:hover{background:#F5FAF7;border-color:var(--border-soft)}\n\n.summary{background:var(--pale);border-radius:3px;padding:26px 24px 24px;position:sticky;top:104px}\n.summary h3{font-size:18px;font-weight:600}\n.summary .gold-rule{margin:14px 0 18px;width:44px}\n.sum-row{margin-bottom:14px}\n.sum-label{display:block;font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:#5C7E6B;margin-bottom:3px}\n.sum-value{display:block;font-size:15px;font-weight:500;line-height:1.45;color:var(--ink)}\n.sum-lines{padding:14px 0 4px;border-top:1px solid rgba(74,124,89,.16)}\n.sum-line{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:5px 0}\n.sum-line .sum-label{margin-bottom:0;flex-shrink:0}\n.sum-line .sum-value{text-align:right}\n.sum-total{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;padding-top:16px;border-top:1px solid rgba(74,124,89,.16)}\n.sum-total .sum-label{margin-bottom:0}\n.total-val{font-family:var(--serif);font-size:25px;font-weight:600}\n.btn-continue{width:100%;margin-top:20px;min-height:46px;background:var(--forest);color:#fff}\n.btn-continue:hover{background:var(--forest-deep)}\n\n/* ================= TRUST ================= */\n.trust{background:var(--pale);padding:42px 0}\n.trust-grid{display:grid;grid-template-columns:repeat(3,1fr)}\n.trust-item{display:flex;align-items:center;justify-content:center;gap:11px;padding:0 24px;font-size:15px;font-weight:500;color:var(--forest);border-right:1px solid #D3E7DC}\n.trust-item:last-child{border-right:0}\n.trust-item i{font-size:19px;color:var(--sage);flex-shrink:0}\n\n/* ================= FOOTER ================= */\n.footer{background:var(--mint);border-top:1px solid rgba(212,175,55,.45);padding:56px 0 26px}\n.footer-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:48px;padding-bottom:32px;border-bottom:1px solid var(--border-soft)}\n.footer-name{display:block;font-family:var(--serif);font-size:25px;font-weight:600;margin-bottom:16px}\n.footer-line{display:flex;align-items:flex-start;gap:10px;font-size:15px;line-height:1.7;color:var(--muted);margin-bottom:8px}\n.footer-line i{font-size:17px;color:var(--sage);margin-top:3px;flex-shrink:0}\n.footer-contact{display:flex;flex-direction:column;gap:12px;padding-top:4px}\n.footer-link{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:500;color:var(--sage);transition:color .18s ease}\n.footer-link:hover{color:var(--forest)}\n.footer-link i{font-size:17px}\n.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding-top:20px;font-size:12px;color:var(--soft)}\n\n/* ================= RESPONSIVE ================= */\n@media (max-width:1200px){\n  .hero-grid{grid-template-columns:1fr}\n  .hero-photo{grid-column:1;height:300px}\n  .hero-text{grid-column:1}\n  .catalogue-grid{grid-template-columns:1fr;gap:32px}\n  .atmosphere{flex-direction:row}\n  .atmosphere figure{flex:1;min-width:0}\n  .atmosphere .a-tall img,.atmosphere .a-wide img{height:220px}\n  .booking-grid{grid-template-columns:1fr}\n  .summary{position:static}\n}\n@media (max-width:1024px){\n  .hero h1{font-size:44px;line-height:52px}\n  .catalogue h2{font-size:34px}\n  .booking h2{font-size:31px}\n  .nav-links{gap:24px}\n}\n@media (max-width:900px){\n  .nav-links{display:none}\n  .treat{grid-template-columns:22px minmax(0,1fr) auto;grid-template-areas:\"check main price\" \"check dur btn\";row-gap:12px;column-gap:14px;padding:16px 18px}\n  .treat-check{grid-area:check;align-self:start;margin-top:3px}\n  .treat-main{grid-area:main}\n  .treat-price{grid-area:price;align-self:start}\n  .treat-dur{grid-area:dur;justify-content:flex-start}\n  .treat-btn{grid-area:btn;min-height:38px;padding:0 14px}\n  .footer-grid{grid-template-columns:1fr;gap:28px}\n}\n@media (max-width:768px){\n  .wrap,.nav-inner,.hero-inner{padding:0 24px}\n  .hero-inner{padding-top:28px;padding-bottom:40px}\n  .nav,.nav-inner{height:68px}\n  .brand-sub{display:none}\n  .hero-photo{height:220px}\n  .hero h1{font-size:34px;line-height:41px}\n  .hero-lead{font-size:16px}\n  .catalogue,.booking{padding:48px 0 56px}\n  .catalogue h2{font-size:29px}\n  .booking h2{font-size:27px}\n  .gold-rule{margin-bottom:28px}\n  .dates{gap:6px}\n  .date{height:58px}\n  .date-dow{font-size:9px;letter-spacing:.04em}\n  .date-num{font-size:16px}\n  .date-note{font-size:8px}\n  .trust-grid{grid-template-columns:1fr}\n  .trust-item{border-right:0;border-bottom:1px solid #D3E7DC;justify-content:flex-start;padding:12px 0}\n  .trust-item:last-child{border-bottom:0}\n  .footer-bottom{flex-direction:column;align-items:flex-start;gap:6px}\n}\n@media (max-width:520px){\n  .atmosphere{flex-direction:column}\n  .atmosphere .a-tall img,.atmosphere .a-wide img{height:200px}\n  .times{grid-template-columns:repeat(2,1fr)}\n  .date{height:54px}\n  .date-note{display:none}\n  .treat h3{font-size:17px}\n  .sum-line{flex-direction:column;gap:1px}\n  .sum-line .sum-value{text-align:left}\n}\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"sticky top navigation header\">\n<div class=\"nav-inner\" data-kid=\"1-1\" data-name=\"navbar inner container\">\n<a aria-label=\"Salon Spa Aleida, inicio\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link to home\" href=\"#inicio\">\n<span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark container\"><img alt=\"Flor de loto de Salon Spa Aleida\" data-kid=\"1-1-1-1-1\" data-name=\"lotus flower logo icon\" decoding=\"async\" height=\"28\" loading=\"lazy\" src=\"/api/local/images/frontend/public/logo_zen_icon.svg\" width=\"28\"/></span>\n<span data-kid=\"1-1-1-2\" data-name=\"brand name text block\">\n<span class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">Salon Spa Aleida</span>\n<span class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subcategory label\">Salón &amp; Spa</span>\n</span>\n</a>\n<nav aria-label=\"Secciones\" class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"main navigation links\">\n<a data-kid=\"1-1-2-1\" data-name=\"nav link to services\" href=\"#servicios\">Servicios</a>\n<a data-kid=\"1-1-2-2\" data-name=\"nav link to booking\" href=\"#reserva\">Reservar</a>\n<a data-kid=\"1-1-2-3\" data-name=\"nav link to contact\" href=\"#contacto\">Contacto</a>\n</nav>\n<a class=\"btn btn-sage\" data-kid=\"1-1-3\" data-name=\"call-to-action book appointment button\" href=\"#reserva\">Reservar Cita</a>\n</div>\n</header>\n<section class=\"hero\" data-kid=\"2\" data-name=\"hero section with forest gradient\" id=\"inicio\">\n<div class=\"hero-inner\" data-kid=\"2-1\" data-name=\"hero inner content wrapper\">\n<div class=\"hero-grid\" data-kid=\"2-1-1\" data-name=\"hero image-and-text grid\">\n<figure class=\"hero-photo\" data-kid=\"2-1-1-1\" data-name=\"hero spa treatment photo\">\n<img alt=\"Camilla de masajes con toallas dobladas y luz cálida. Foto: Marine Fougère / Pexels\" data-kid=\"2-1-1-1-1\" data-name=\"spa massage bed photograph\" decoding=\"async\" height=\"250\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35884502/pexels-photo-35884502.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200&amp;q=80\" width=\"760\"/>\n</figure>\n<div class=\"hero-text\" data-kid=\"2-1-1-2\" data-name=\"hero text block\">\n<h1 data-kid=\"2-1-1-2-1\" data-name=\"hero headline\">Renueva tu Belleza,<br data-kid=\"2-1-1-2-1-1\" data-name=\"line break in headline\"/>Equilibra tu Bienestar</h1>\n<p class=\"hero-lead\" data-kid=\"2-1-1-2-2\" data-name=\"hero lead paragraph\">Combinamos rituales terapéuticos botánicos, tratamientos faciales antiedad y estilismo capilar personalizado en un ambiente de calma y cuidado integral.</p>\n<div class=\"hero-cta\" data-kid=\"2-1-1-2-3\" data-name=\"hero call-to-action wrapper\"><a class=\"btn btn-sage\" data-kid=\"2-1-1-2-3-1\" data-name=\"hero primary book appointment button\" href=\"#reserva\">Reservar Cita</a></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"catalogue\" data-kid=\"3\" data-name=\"services catalogue section\" id=\"servicios\">\n<div class=\"wrap\" data-kid=\"3-1\" data-name=\"catalogue content wrapper\">\n<div class=\"catalogue-head\" data-kid=\"3-1-1\" data-name=\"catalogue section header\"><h2 data-kid=\"3-1-1-1\" data-name=\"catalogue section title\">Carta de Servicios</h2></div>\n<div class=\"catalogue-grid\" data-kid=\"3-1-2\" data-name=\"catalogue two-column layout\">\n<aside class=\"atmosphere\" data-kid=\"3-1-2-1\" data-name=\"atmosphere photo sidebar\">\n<figure class=\"a-tall\" data-kid=\"3-1-2-1-1\" data-name=\"tall private cabin photo\">\n<img alt=\"Cabina privada con camilla y cortinas de madera. Foto: KoolShooters / Pexels\" data-kid=\"3-1-2-1-1-1\" data-name=\"private cabin interior photograph\" decoding=\"async\" height=\"392\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6628520/pexels-photo-6628520.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=700&amp;q=80\" width=\"300\"/>\n</figure>\n<figure class=\"a-wide\" data-kid=\"3-1-2-1-2\" data-name=\"wide eucalyptus photo\">\n<img alt=\"Toallas dobladas junto a frascos de aceite y una vela. Foto: Alesia Kozik / Pexels\" data-kid=\"3-1-2-1-2-1\" data-name=\"spa still life photograph\" decoding=\"async\" height=\"208\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7795793/pexels-photo-7795793.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=700&amp;q=80\" width=\"300\"/>\n</figure>\n</aside>\n<div class=\"menu\" data-kid=\"3-1-2-2\" data-name=\"treatments menu list\" id=\"menu\">\n<div aria-pressed=\"true\" class=\"treat is-selected\" data-kid=\"3-1-2-2-1\" data-name=\"treatment card for relaxing massage\" data-service=\"0\" role=\"button\" tabindex=\"0\">\n<span class=\"treat-check\" data-kid=\"3-1-2-2-1-1\" data-name=\"treatment selection indicator circle\"><i class=\"ti ti-check\" data-kid=\"3-1-2-2-1-1-1\" data-name=\"checkmark icon in selection indicator\"></i></span>\n<div class=\"treat-main\" data-kid=\"3-1-2-2-1-2\" data-name=\"treatment name and description block\">\n<h3 data-kid=\"3-1-2-2-1-2-1\" data-name=\"treatment title\">Masaje Relajante Aleida</h3>\n<p class=\"treat-desc\" data-kid=\"3-1-2-2-1-2-2\" data-name=\"treatment description\">Terapia antiestrés con aceites botánicos, aromaterapia personalizada y piedras calientes para disolver tensiones acumuladas.</p>\n</div>\n<div class=\"treat-dur\" data-kid=\"3-1-2-2-1-3\" data-name=\"treatment duration\"><i class=\"ti ti-clock\" data-kid=\"3-1-2-2-1-3-1\" data-name=\"clock icon\"></i>90 min</div>\n<div class=\"treat-price\" data-kid=\"3-1-2-2-1-4\" data-name=\"treatment price\">S/ 280.00</div>\n<div class=\"treat-btn\" data-kid=\"3-1-2-2-1-5\" data-name=\"treatment book now button\">Reservar Cita</div>\n</div>\n<div aria-pressed=\"false\" class=\"treat\" data-kid=\"3-1-2-2-2\" data-name=\"treatment card for gold facial\" data-service=\"1\" role=\"button\" tabindex=\"0\">\n<span class=\"treat-check\" data-kid=\"3-1-2-2-2-1\" data-name=\"treatment selection indicator circle\"><i class=\"ti ti-check\" data-kid=\"3-1-2-2-2-1-1\" data-name=\"checkmark icon in selection indicator\"></i></span>\n<div class=\"treat-main\" data-kid=\"3-1-2-2-2-2\" data-name=\"treatment name and description block\">\n<h3 data-kid=\"3-1-2-2-2-2-1\" data-name=\"treatment title\">Facial Rejuvenecedor con Oro</h3>\n<p class=\"treat-desc\" data-kid=\"3-1-2-2-2-2-2\" data-name=\"treatment description\">Limpieza profunda e hidratación intensiva con micropartículas de oro coloidal y colágeno hidrolizado purificado.</p>\n</div>\n<div class=\"treat-dur\" data-kid=\"3-1-2-2-2-3\" data-name=\"treatment duration\"><i class=\"ti ti-clock\" data-kid=\"3-1-2-2-2-3-1\" data-name=\"clock icon\"></i>75 min</div>\n<div class=\"treat-price\" data-kid=\"3-1-2-2-2-4\" data-name=\"treatment price\">S/ 450.00</div>\n<div class=\"treat-btn\" data-kid=\"3-1-2-2-2-5\" data-name=\"treatment book now button\">Reservar Cita</div>\n</div>\n<div aria-pressed=\"false\" class=\"treat\" data-kid=\"3-1-2-2-3\" data-name=\"treatment card for keratin hair treatment\" data-service=\"2\" role=\"button\" tabindex=\"0\">\n<span class=\"treat-check\" data-kid=\"3-1-2-2-3-1\" data-name=\"treatment selection indicator circle\"><i class=\"ti ti-check\" data-kid=\"3-1-2-2-3-1-1\" data-name=\"checkmark icon in selection indicator\"></i></span>\n<div class=\"treat-main\" data-kid=\"3-1-2-2-3-2\" data-name=\"treatment name and description block\">\n<h3 data-kid=\"3-1-2-2-3-2-1\" data-name=\"treatment title\">Tratamiento Capilar Keratina</h3>\n<p class=\"treat-desc\" data-kid=\"3-1-2-2-3-2-2\" data-name=\"treatment description\">Nutrición intensiva con sellado térmico para eliminación total del frizz y brillo prolongado de calidad profesional.</p>\n</div>\n<div class=\"treat-dur\" data-kid=\"3-1-2-2-3-3\" data-name=\"treatment duration\"><i class=\"ti ti-clock\" data-kid=\"3-1-2-2-3-3-1\" data-name=\"clock icon\"></i>120 min</div>\n<div class=\"treat-price\" data-kid=\"3-1-2-2-3-4\" data-name=\"treatment price\">S/ 350.00</div>\n<div class=\"treat-btn\" data-kid=\"3-1-2-2-3-5\" data-name=\"treatment book now button\">Reservar Cita</div>\n</div>\n<div aria-pressed=\"false\" class=\"treat\" data-kid=\"3-1-2-2-4\" data-name=\"treatment card for spa manicure\" data-service=\"3\" role=\"button\" tabindex=\"0\">\n<span class=\"treat-check\" data-kid=\"3-1-2-2-4-1\" data-name=\"treatment selection indicator circle\"><i class=\"ti ti-check\" data-kid=\"3-1-2-2-4-1-1\" data-name=\"checkmark icon in selection indicator\"></i></span>\n<div class=\"treat-main\" data-kid=\"3-1-2-2-4-2\" data-name=\"treatment name and description block\">\n<h3 data-kid=\"3-1-2-2-4-2-1\" data-name=\"treatment title\">Manicura Spa Premium</h3>\n<p class=\"treat-desc\" data-kid=\"3-1-2-2-4-2-2\" data-name=\"treatment description\">Exfoliación con sales minerales marinas, hidratación profunda con parafina tibia y esmaltado de alta duración.</p>\n</div>\n<div class=\"treat-dur\" data-kid=\"3-1-2-2-4-3\" data-name=\"treatment duration\"><i class=\"ti ti-clock\" data-kid=\"3-1-2-2-4-3-1\" data-name=\"clock icon\"></i>60 min</div>\n<div class=\"treat-price\" data-kid=\"3-1-2-2-4-4\" data-name=\"treatment price\">S/ 150.00</div>\n<div class=\"treat-btn\" data-kid=\"3-1-2-2-4-5\" data-name=\"treatment book now button\">Reservar Cita</div>\n</div>\n<div aria-pressed=\"false\" class=\"treat\" data-kid=\"3-1-2-2-5\" data-name=\"treatment card for hair styling\" data-service=\"4\" role=\"button\" tabindex=\"0\">\n<span class=\"treat-check\" data-kid=\"3-1-2-2-5-1\" data-name=\"treatment selection indicator circle\"><i class=\"ti ti-check\" data-kid=\"3-1-2-2-5-1-1\" data-name=\"checkmark icon in selection indicator\"></i></span>\n<div class=\"treat-main\" data-kid=\"3-1-2-2-5-2\" data-name=\"treatment name and description block\">\n<h3 data-kid=\"3-1-2-2-5-2-1\" data-name=\"treatment title\">Corte y Peinado de Estilo</h3>\n<p class=\"treat-desc\" data-kid=\"3-1-2-2-5-2-2\" data-name=\"treatment description\">Asesoría de visagismo personalizada, lavado con shampoo dermocosmético, corte de autor y estilizado profesional.</p>\n</div>\n<div class=\"treat-dur\" data-kid=\"3-1-2-2-5-3\" data-name=\"treatment duration\"><i class=\"ti ti-clock\" data-kid=\"3-1-2-2-5-3-1\" data-name=\"clock icon\"></i>45 min</div>\n<div class=\"treat-price\" data-kid=\"3-1-2-2-5-4\" data-name=\"treatment price\">S/ 120.00</div>\n<div class=\"treat-btn\" data-kid=\"3-1-2-2-5-5\" data-name=\"treatment book now button\">Reservar Cita</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"booking\" data-kid=\"4\" data-name=\"booking section\" id=\"reserva\">\n<div class=\"wrap\" data-kid=\"4-1\" data-name=\"booking content wrapper\">\n<h2 data-kid=\"4-1-1\" data-name=\"booking section title\">Reserva tu Cita</h2>\n<div class=\"gold-rule\" data-kid=\"4-1-2\" data-name=\"gold decorative rule\"></div>\n<div class=\"booking-grid\" data-kid=\"4-1-3\" data-name=\"booking two-column layout\">\n<div class=\"booking-left\" data-kid=\"4-1-3-1\" data-name=\"booking form fields\">\n<div class=\"field\" data-kid=\"4-1-3-1-1\" data-name=\"service field group\">\n<label class=\"field-label\" data-kid=\"4-1-3-1-1-1\" data-name=\"service field label\" for=\"service-select\">Servicio</label>\n<div class=\"select-wrap\" data-kid=\"4-1-3-1-1-2\" data-name=\"service select wrapper\">\n<select data-kid=\"4-1-3-1-1-2-1\" data-name=\"service dropdown select\" id=\"service-select\">\n<option data-kid=\"4-1-3-1-1-2-1-1\" data-name=\"service option for relaxing massage\" selected=\"\" value=\"0\">Masaje Relajante Aleida</option>\n<option data-kid=\"4-1-3-1-1-2-1-2\" data-name=\"service option for gold facial\" value=\"1\">Facial Rejuvenecedor con Oro</option>\n<option data-dynamic=\"true\" data-kid=\"4-1-3-1-1-2-1-3\" data-name=\"service option for keratin hair\" data-reason=\"select value reassigned by script when a treatment card is clicked\" value=\"2\">Tratamiento Capilar Keratina</option>\n<option data-kid=\"4-1-3-1-1-2-1-4\" data-name=\"service option for spa manicure\" value=\"3\">Manicura Spa Premium</option>\n<option data-kid=\"4-1-3-1-1-2-1-5\" data-name=\"service option for hair styling\" value=\"4\">Corte y Peinado de Estilo</option>\n</select>\n<i class=\"ti ti-chevron-down\" data-kid=\"4-1-3-1-1-2-2\" data-name=\"down chevron icon on select\"></i>\n</div>\n</div>\n<div class=\"field\" data-kid=\"4-1-3-1-2\" data-name=\"specialist field group\">\n<span class=\"field-label\" data-kid=\"4-1-3-1-2-1\" data-name=\"specialist field label\">Especialista</span>\n<div class=\"specialist-list\" data-kid=\"4-1-3-1-2-2\" data-name=\"specialist list container\" id=\"specialists\">\n<button class=\"specialist is-selected\" data-kid=\"4-1-3-1-2-2-1\" data-name=\"specialist option for Carmen Sánchez\" data-specialist=\"Carmen Sánchez\" type=\"button\">\n<img alt=\"Carmen Sánchez. Foto: xandro Vandewalle / Unsplash\" data-kid=\"4-1-3-1-2-2-1-1\" data-name=\"specialist avatar photo\" decoding=\"asy